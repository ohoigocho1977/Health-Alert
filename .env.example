# GEMINI_API_KEY: Required for server-side Gemini AI risk intelligence synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# HEALTHALERT_SESSION_SECRET: Long random secret used to sign HMAC-SHA256 session tokens.
HEALTHALERT_SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Role Authorization Codes (server-side only):
# Required if allowing Community Health Workers or Health Administrators to self-register.
HEALTH_WORKER_INVITE_CODE=""
ADMIN_INVITE_CODE=""

# Optional Initial Seed Passwords (never hardcoded in source):
# Set these if you want to enable login for the seeded Lagos demonstration personas.
SEED_ADMIN_EMAIL="admin@healthalert.ng"
SEED_ADMIN_PASSWORD=""
SEED_WORKER_PASSWORD=""
SEED_RESIDENT_PASSWORD=""
